      "integrationPoints": [
        "AKS",
        "Azure Container Registry",
        "Log Analytics"
      ]
    }
  },
  {
    "id": "existing-log-analytics",
    "existingResource": {
      "id": "azurerm_log_analytics_workspace.this",
