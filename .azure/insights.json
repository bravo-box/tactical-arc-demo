      "name": "log-${var.name_prefix}",
      "role": "reference-and-integrate",
      "must_not_recreate": true,
      "integrationPoints": [
        "AKS Container Insights",
        "Azure diagnostics"
      ]
    }
  },
  {
    "id": "existing-acr",
    "existingResource": {
      "id": "azurerm_container_registry.this",
      "type": "Microsoft.ContainerRegistry/registries",
      "name": "cr${var.name_prefix}${random_string.suffix.result}",
      "role": "reference-and-integrate",
      "must_not_recreate": true,
      "integrationPoints": [
        "AKS kubelet image pulls",
        "Private endpoint"
      ]
    }
  },
  {
    "id": "existing-aks",
